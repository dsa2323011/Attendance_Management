@app.post("/api/scan")
async def scan_card(tag_id: str): # クライアントから送られてくるNFCの固有ID(IDm)
    conn = sqlite3.connect("database.db")
    cursor = conn.cursor()
    
    # 事前設定された番号があるか照合
    cursor.execute("SELECT student_id, name FROM allowed_students WHERE tag_id = ?", (tag_id,))
    result = cursor.fetchone()
    
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    if result:
        # 登録済みの場合
        status = "ALLOWED"
        student_id = result[0]
        message = f"認証成功: {result[1]}さん"
    else:
        # 【追加】未登録タグ（初見）の場合
        status = "UNKNOWN_TAG"
        student_id = "未登録"
        message = f"未登録のタグです (ID: {tag_id})"
        
        # ※ここで「未登録タグリスト」のテーブルに自動保存する処理を入れると、
        # 後からWeb画面で一覧表示して、まとめて名前を割り当てることができます。
        
    # 履歴に保存
    cursor.execute(
        "INSERT INTO access_logs (student_id, status, timestamp, tag_id) VALUES (?, ?, ?, ?)",
        (student_id, status, timestamp, tag_id)
    )
    conn.commit()
    conn.close()
    
    return {"status": status, "message": message}